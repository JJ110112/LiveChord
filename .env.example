# LiveChord environment variables — copy to .env (gitignored) and fill in.
# Never commit .env.

# Deployment mode: personal | beta | public
LIVECHORD_MODE=personal

# Admin gate (public mode): comma-separated emails matched against OAuth claim.
LIVECHORD_ADMIN_EMAILS=

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth — Apple (deferred; fill when Apple Developer Program enrolled)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# OAuth callback base — public deployment uses https://livechord.org
# Local dev with LIVECHORD_MODE=public uses http://localhost:8804
OAUTH_REDIRECT_BASE=https://livechord.org
